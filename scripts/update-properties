#!/bin/bash
# Collect i18nString("...") keys from all Gradle modules and merge into
# app/src/main/resources/strings_ja.properties

set -euo pipefail

function last_modified() {
	if [ "$(uname)" = "Darwin" ]; then
		stat -f "%m" "$1"
	else
		stat -c %Y "$1"
	fi
}

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

ja_properties=app/src/main/resources/strings_ja.properties
ja_properties_ja_orig=$(mktemp)
ja_properties_ja_new=$(mktemp)
ja_properties_ja_merged=$(mktemp)
ja_properties_ja_sorted=$(mktemp)
tmp_keys=$(mktemp)
tmp_msgs=$(mktemp)

# Match i18nString("...") / i18nString('...') across multi-module sources.
grep -R --include='*.kt' --include='*.java' -ohE 'i18nString\("[^"]*"' \
	app common model protocols core extensions gui gulp 2>/dev/null \
	| grep -oE '"[^"]*"' | sed 's/"//g' | sort -u > "$tmp_msgs" || true

# Also keep legacy I18nString.get("...") if any remain.
grep -R --include='*.kt' --include='*.java' -ohE 'I18nString\.get\("[^"]*"' \
	app common model protocols core extensions gui gulp 2>/dev/null \
	| grep -oE '"[^"]*"' | sed 's/"//g' | sort -u >> "$tmp_msgs" || true

sort -u "$tmp_msgs" -o "$tmp_msgs"

# Normalize keys the same way I18nString.normalize does.
sed 's/ /_/g; s/=/_/g; s/:/\\:/g; s/(/\\(/g; s/)/\\)/g' "$tmp_msgs" > "$tmp_keys"

sort -b "$ja_properties" | sed 's/=/@@/g' | sed 's/@@/=/' > "$ja_properties_ja_orig"
paste -d = "$tmp_keys" "$tmp_msgs" | sort -b | uniq > "$ja_properties_ja_new"
join -t = -a 1 -o "1.1 2.2" "$ja_properties_ja_new" "$ja_properties_ja_orig" > "$ja_properties_ja_merged"
join -t = -v 2 "$ja_properties_ja_new" "$ja_properties_ja_orig" >> "$ja_properties_ja_merged"
sort -b "$ja_properties_ja_merged" | sed 's/@@/=/g' > "$ja_properties_ja_sorted"

old=$(last_modified "$ja_properties_ja_sorted")
"${EDITOR:-vim}" "$ja_properties_ja_sorted"
new=$(last_modified "$ja_properties_ja_sorted")
if [ "$old" -eq "$new" ]; then
	echo "Abort"
	exit 1
fi
cp "$ja_properties_ja_sorted" "$ja_properties"
echo "Updated $ja_properties"

rm -f "$ja_properties_ja_orig" "$ja_properties_ja_new" "$ja_properties_ja_merged" "$ja_properties_ja_sorted" "$tmp_keys" "$tmp_msgs"
